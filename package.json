    "test": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "execa": "^9.3.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
