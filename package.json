{
  "name": "czarina-video-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render-Worker: baut lokalisierte Tonspur + Untertitel auf Bildschirmaufnahmen (ffmpeg).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
