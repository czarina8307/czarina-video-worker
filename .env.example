# Supabase (Projekt des Czarina Tools)
SUPABASE_URL=https://ldxcceppmgzrjfbaikee.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key aus Supabase Dashboard>

# Geheimnis, das n8n als "Authorization: Bearer <WORKER_TOKEN>" mitschickt.
# Erzeugen mit:  openssl rand -hex 32
WORKER_TOKEN=<langes-zufaelliges-geheimnis>

# Ziel-Bucket, falls der Request keinen output_bucket angibt
DEFAULT_OUTPUT_BUCKET=video-localization

# Optional
PORT=8080
# Wie viele Renders gleichzeitig (ffmpeg ist CPU-lastig -> auf kleinem VPS 1 lassen)
RENDER_CONCURRENCY=1
# Harte Obergrenze pro Render in Sekunden (danach wird der Job als "error" markiert)
RENDER_TIMEOUT_SEC=1800
